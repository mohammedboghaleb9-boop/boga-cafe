{
  "name": "boga-cafe",
  "private": true,
  "version": "0.1.0",
  "description": "BOGA CAFÉ — official website, online coffee store, Custom Blend system, B2B and admin panel.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:demo": "vite build --mode demo",
    "build:e2e": "vite build --mode e2e",
    "check:real-build": "node scripts/check-real-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "nodemailer": "^10.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
