# Data backend: "demo" (browser storage, no server) or "supabase" (production, phase 2)
VITE_DATA_MODE=demo
# Router: "browser" for the real domain, "hash" for static previews (falls back to in-memory when URL changes are blocked)
VITE_ROUTER=browser
# Automatic WhatsApp + Gmail notifications (api/notify.ts). Empty = off (the customer's
# "send on WhatsApp / Gmail" step is then the only delivery). On Vercel: /api/notify
VITE_NOTIFY_URL=
