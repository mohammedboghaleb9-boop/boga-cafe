VITE_DATA_MODE=demo
VITE_ROUTER=browser
# Phase 2 (Supabase) — public values only, never put secret keys here
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Automatic notifications — the site calls this after every order, sample and B2B quote
VITE_NOTIFY_URL=/api/notify

# ───── Server only (Vercel → Project → Settings → Environment Variables) ─────
# Never prefix these with VITE_: they must not reach the browser.
# Gmail: the sending account and a 16-character App Password
#   (Google account → Security → 2-Step Verification → App passwords)
GMAIL_USER=bogacafe1@gmail.com
GMAIL_APP_PASSWORD=
# Where the emails arrive (defaults to GMAIL_USER)
NOTIFY_EMAIL_TO=bogacafe1@gmail.com
# WhatsApp to the owner's own number through CallMeBot (one-time activation gives the key)
CALLMEBOT_PHONE=212609036378
CALLMEBOT_APIKEY=
# Required: the website address(es) allowed to call the function, comma separated
ALLOWED_ORIGIN=https://your-domain.ma,https://www.your-domain.ma
