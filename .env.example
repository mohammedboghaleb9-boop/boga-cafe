# Copy to .env (never committed) and fill in. Every value has a safe default when empty.
# VITE_DATA_MODE empty = the production build, the "coming soon" page (scripts/build-target.mjs); demo = the prototype
VITE_DATA_MODE=demo
VITE_ROUTER=browser
# VITE_DATA_MODE=supabase reads the live database (both values below are then required)
# Supabase — public values only, never put secret keys here (the build refuses one)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public; its secret goes to Supabase → Edge Functions → Secrets as TURNSTILE_SECRET_KEY,
# next to TURNSTILE_HOSTNAMES: the hostnames a token may be solved on, comma separated, not a secret, for example
# boga-cafe.<account>.workers.dev,*-boga-cafe.<account>.workers.dev  — the star is for the previews only).
# Required with VITE_DATA_MODE=supabase. Copy it from the "Site Key" field of the widget, never the secret one: the build stops on a value
# that is too long for a site key (a secret key is 35 characters) and on Cloudflare's test secrets. Cloudflare's test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Prototype only (demo build): the browser calls this after an order or B2B request. The live site
# (VITE_DATA_MODE=supabase) ignores it: the database queues the messages (notification_outbox); their sender is phase 4.
VITE_NOTIFY_URL=/api/notify

# Card payments: leave empty until the CMI gateway is connected (phase D).
# Empty = the card shows as "coming soon" and cannot be chosen. "demo" is for the prototype only.
VITE_CARD_GATEWAY=

# ───── api/notify.ts only (a Vercel function: NOT deployed, the site is on Cloudflare Workers; phase 4 replaces it) ─────
# Never prefix these with VITE_: they must not reach the browser.
# Gmail: the sending account and a 16-character App Password
#   (Google account → Security → 2-Step Verification → App passwords)
GMAIL_USER=bogacafe1@gmail.com
GMAIL_APP_PASSWORD=
# Where the emails arrive (defaults to GMAIL_USER)
NOTIFY_EMAIL_TO=bogacafe1@gmail.com
# WhatsApp to the owner's own number through CallMeBot (one-time activation gives the key)
CALLMEBOT_PHONE=212609036378
CALLMEBOT_APIKEY=
# Required: the website address(es) allowed to call the function, comma separated
ALLOWED_ORIGIN=https://your-domain.ma,https://www.your-domain.ma
