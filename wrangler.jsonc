// Cloudflare Workers (Workers Builds deploys `main`; other branches upload a preview version).
// Static site only: the files of `npm run build` in ./dist, any unknown path answered with
// index.html (production: the "coming soon" page for every path; previews: the React router's page).
// Same values as the configuration Cloudflare's auto-setup generated for build 344952f.
{
  "name": "boga-cafe",
  "compatibility_date": "2026-10-06",
  // Version URLs (<version>-boga-cafe.<subdomain>.workers.dev, and the branch alias) stay OFF
  // (owner 2026-10-17): a branch build is the shop on the live database, so a public link to it
  // could take real orders before the sales gate. The owner turned them off in the dashboard;
  // `false` keeps them off, because `wrangler deploy` (main) writes this value to the Worker
  // (true here would turn them back on). `wrangler versions upload` (branch builds) only reads it.
  // The production workers.dev URL is unchanged (workers_dev defaults to true without routes).
  // https://developers.cloudflare.com/workers/versions-and-deployments/version-urls/
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
